def solve(n):
    board = [-1] * n

    def safe(row, col):
        for i in range(row):
            if board[i] == col or abs(board[i] - col) == abs(i - row):
                return False
        return True

    def backtrack(row):
        if row == n:
            return True

        for col in range(n):
            if safe(row, col):
                board[row] = col
                if backtrack(row + 1):
                    return True
                board[row] = -1

        return False

    backtrack(0)

    for r in range(n):
        print(" ".join("Q" if board[r] == c else "." for c in range(n)))

solve(8)
