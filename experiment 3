from collections import deque

def water_jug(a, b, target):
    q = deque([((0, 0), [])])
    seen = {(0, 0)}

    while q:
        (x, y), path = q.popleft()
        path = path + [(x, y)]

        if x == target or y == target:
            for p in path:
                print(p)
            return

        states = [
            (a, y), (x, b), (0, y), (x, 0),
            (x - min(x, b-y), y + min(x, b-y)),
            (x + min(y, a-x), y - min(y, a-x))
        ]

        for s in states:
            if s not in seen:
                seen.add(s)
                q.append((s, path))

water_jug(4, 3, 2)
