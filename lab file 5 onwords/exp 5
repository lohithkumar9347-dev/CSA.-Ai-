from collections import deque

def solve():
    start = (3, 3, 1)
    goal = (0, 0, 0)
    q = deque([(start, [start])])
    visited = set()

    moves = [(1, 0), (2, 0), (0, 1),
             (0, 2), (1, 1)]

    while q:
        state, path = q.popleft()
        m, c, boat = state

        if state == goal:
            for p in path:
                print(p)
            return

        if state in visited:
            continue
        visited.add(state)

        for x, y in moves:
            if boat == 1:
                nm, nc, nb = m-x, c-y, 0
            else:
                nm, nc, nb = m+x, c+y, 1

            if 0 <= nm <= 3 and 0 <= nc <= 3:
                if (nm == 0 or nm >= nc) and \
                   (3-nm == 0 or 3-nm >= 3-nc):
                    q.append(((nm, nc, nb), path + [(nm, nc, nb)]))

solve()
