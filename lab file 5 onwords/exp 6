def vacuum_cleaner():
    room = {"A": 1, "B": 1}
    position = "A"

    while 1 in room.values():
        print("Position:", position)

        if room[position] == 1:
            print("Cleaning room", position)
            room[position] = 0

        elif position == "A":
            position = "B"
        else:
            position = "A"

    print("Both rooms are clean!")

vacuum_cleaner()
