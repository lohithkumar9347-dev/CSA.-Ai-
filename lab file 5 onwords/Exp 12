board = [" "] * 9

def show():
    print(board[0:3])
    print(board[3:6])
    print(board[6:9])

for turn in range(9):
    show()
    p = "X" if turn % 2 == 0 else "O"
    pos = int(input(p + " enter position (1-9): ")) - 1

    if board[pos] == " ":
        board[pos] = p
    else:
        print("Position occupied!")
        continue

    wins = [(0,1,2),(3,4,5),(6,7,8),
            (0,3,6),(1,4,7),(2,5,8),
            (0,4,8),(2,4,6)]

    if any(board[a] == board[b] == board[c] == p
           for a,b,c in wins):
        show()
        print(p, "wins!")
        break
else:
    show()
    print("Draw!")
