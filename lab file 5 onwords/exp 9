from itertools import permutations

dist = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

n = 4
min_cost = 9999
best_path = []

for p in permutations(range(1, n)):
    path = [0] + list(p) + [0]
    cost = 0

    for i in range(len(path) - 1):
        cost += dist[path[i]][path[i + 1]]

    if cost < min_cost:
        min_cost = cost
        best_path = path

print("Shortest Path:", best_path)
print("Minimum Cost:", min_cost)
